# ============================================================================
#  Website Builder AI Service (FastAPI) — environment configuration
#  Copy to ".env" and fill in real values. NEVER commit the real .env.
# ============================================================================

# --- App ---
APP_ENV=dev                       # dev | staging | prod
API_PREFIX=/api/ai                # all protected routes mount under this

# --- CORS: exact Next.js origin(s), comma-separated. No "*" in prod. ---
CORS_ORIGINS=http://localhost:3000

# --- JWT: must match how the Codex (Spring Boot) app SIGNS its tokens ---
# Codex uses HMAC with a 64-byte secret, which jjwt signs as HS512.
# (HS* accepts the whole HMAC family; the secret just has to match.)
JWT_ALGORITHM=HS512

# The SAME value as JWT_SECRET in the Codex backend's .env (must be >= 32 bytes):
JWT_SECRET=<PASTE_THE_EXACT_CODEX_JWT_SECRET_HERE>

# If you ever switch Codex to RS256, paste the PEM PUBLIC key instead:
# JWT_ALGORITHM=RS256
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Codex puts the user UUID in the "userId" claim ("sub" is the username):
JWT_USER_ID_CLAIM=userId
# Optional hardening (Codex tokens don't set iss/aud today, so leave unset):
# JWT_ISSUER=
# JWT_AUDIENCE=

# --- Database: reuse the EXISTING Postgres; we only add new tables ---
# Async driver form (note the +asyncpg):
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:5432/<DBNAME>

# --- LLM ---
GROQ_API_KEY=<YOUR_GROQ_API_KEY_HERE>
# GROQ_MODEL=llama-3.3-70b-versatile
# AGENT_DEBUG=false                 # set true to dump LangChain internals

# ============================================================================
#  Frontend (Next.js) — these do NOT belong here. Put them in
#  frontend/.env.local, and only if you need to override the defaults.
# ============================================================================
# NEXT_PUBLIC_API_BASE=http://localhost:8001/api/ai
# NEXT_PUBLIC_WS_BASE=ws://localhost:8001/api/ai
# NEXT_PUBLIC_SITE_URL=http://localhost:3000   # canonical URL for OG metadata
# NEXT_PUBLIC_DEV_AUTH_TOKEN=dev-token         # dev-only auth fallback
